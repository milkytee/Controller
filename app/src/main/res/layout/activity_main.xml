<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1A1A1A">

    <!-- 顶部状态栏（横跨整个屏幕） -->
    <LinearLayout
        android:id="@+id/topStatusBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMARTDIG"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginEnd="24dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvVideoLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="延迟: 52ms"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tvRcSignal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="信号: ████████"
            android:textColor="#00FF00"
            android:textSize="14sp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tvBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="电池: 85%"
            android:textColor="#00FF00"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 背景图片/视频流（从左边开始，占据到右侧面板前的所有空间） -->
    <com.skydroid.fpvplayer.FPVWidget
        android:id="@+id/fpvWidget"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FF000000"
        app:layout_constraintTop_toBottomOf="@id/topStatusBar"
        app:layout_constraintBottom_toTopOf="@id/controlButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rightPanel"
        tools:ignore="ContentDescription" />


    <!-- 右侧面板容器 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rightPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/topStatusBar"
        app:layout_constraintBottom_toTopOf="@id/controlButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.30">

        <!-- 挖机姿态可视化器面板 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPosture"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="-12dp"
            app:cardBackgroundColor="#CC000000"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/cardPositioning">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="start">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="POSTURE VISUALIZER"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- 挖机姿态视图 -->
                <com.example.myapplication.ExcavatorPostureView
                    android:id="@+id/excavatorPostureView"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_gravity="start"
                    android:background="#FF000000" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 定位信息面板 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPositioning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="-12dp"
            app:cardBackgroundColor="#CC000000"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/cardPosture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/cardDigDepth">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="POSITIONING"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingBottom="4dp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvLatitude"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="LAT: 31.230400 N"
                    android:textColor="#CCCCCC"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvLongitude"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LNG: 121.473700 E"
                    android:textColor="#CCCCCC"
                    android:textSize="9sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 挖掘深度面板和机器角度面板（并排） -->
        <LinearLayout
            android:id="@+id/cardDigDepth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="-12dp"
            app:layout_constraintTop_toBottomOf="@id/cardPositioning"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- 挖掘深度面板 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                app:cardBackgroundColor="#CC000000"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="DIG DEPTH"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingBottom="4dp"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvDigDepth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3.23 m"
                        android:textColor="#FFD700"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:paddingBottom="6dp"
                        android:gravity="center" />

                    <ProgressBar
                        android:id="@+id/progressDigDepth"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="1000"
                        android:progress="323"
                        android:progressTint="#FFD700" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 机器角度面板 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                app:cardBackgroundColor="#CC000000"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ANGLES"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingBottom="4dp"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvBoomAngle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="BOOM: -30°"
                        android:textColor="#888888"
                        android:textSize="9sp"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvStickAngle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="STICK: 45°"
                        android:textColor="#FFA500"
                        android:textSize="9sp"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvBucketAngle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="BUCKET: 10°"
                        android:textColor="#FFD700"
                        android:textSize="9sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 底部：控制按钮横向一排（横跨整个宽度） -->
    <LinearLayout
        android:id="@+id/controlButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="6dp"
        app:layout_constraintTop_toBottomOf="@id/fpvWidget"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnLights"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="60dp"
            android:text="💡 亮灯"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#FF8800"
            style="@style/Widget.Material3.Button" />

        <Button
            android:id="@+id/btnHorn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="60dp"
            android:text="🔊 鸣笛"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#FF8800"
            style="@style/Widget.Material3.Button" />

        <Button
            android:id="@+id/btnModeSwitch"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="100dp"
            android:text="手动驾驶"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#00AAFF"
            style="@style/Widget.Material3.Button" />

        <Button
            android:id="@+id/btnHome"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="60dp"
            android:text="🏠 主页"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#888888"
            style="@style/Widget.Material3.Button" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="60dp"
            android:text="⏹ 急停"
            android:textSize="12sp"
            android:backgroundTint="#FF0000"
            style="@style/Widget.Material3.Button" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
